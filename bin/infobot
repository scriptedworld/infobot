#!/bin/sh
# The status line's entry point. Claude Code names a path to this file in
# settings.json, so this file is committed and the binary beside it is not.
#
# RESOLVE SYMLINKS BEFORE LOOKING FOR THE BINARY. Claude Code reaches this
# through a symlink in some other directory. `dirname "$0"` on the symlink's
# own path gives that directory, so the binary this looked for was the symlink
# itself, which is this script. It exec'd itself, forever.
#
# That ran for 35 minutes across ten sessions on 2026-08-28 and cost every
# session its state file, silently: the loop never reaches the render, so there
# is no output, and a status line that prints nothing looks like a quiet one.
# The Python this replaced called Path(__file__).resolve(), which follows
# symlinks, and the port dropped that without noticing it was load-bearing.
#
# THIS EXISTS TO SATISFY FR-1.13, and it is the trade the Go port makes. An
# import that might not resolve became a build that might not have run, and both
# fail the same way, as a blank line nobody is told about. A status line has no
# other tell: it is drawn or it is not, and a blank one is indistinguishable
# from a quiet session. So an absent binary says so, in the place the line would
# have been.
set -u

# readlink -f resolves every link in the chain and gives an absolute path.
self=$(readlink -f "$0" 2>/dev/null) || self=$0
[ -n "$self" ] || self=$0
here=$(dirname "$self")
binary="$here/statusline"

# Belt and braces. If the resolution above ever fails and lands back on this
# script, say the binary is missing rather than exec into a loop. A wrong answer
# is recoverable and a fork bomb across every session is not.
if [ -x "$binary" ] && [ "$(readlink -f "$binary" 2>/dev/null)" != "$self" ]; then
    exec "$binary"
fi

# Claude Code is writing the payload into this process. Exiting without reading
# it hands the writer an EPIPE for a condition that is ours, not theirs.
cat >/dev/null 2>&1 || true

# The same rail and dim cyan the render uses, so this reads as the status line
# saying something rather than as a stray error. NO_COLOR is honoured here too:
# a hardcoded escape surviving the stripping of everything around it is exactly
# what FR-3.8 exists to prevent.
if [ -n "${NO_COLOR:-}" ]; then
    printf '%s\n' "-- infobot is not built: go build -o bin/statusline ./cmd/statusline"
else
    printf '\033[38;2;0;95;95m╶─ \033[0m\033[38;2;225;45;45minfobot is not built\033[0m \033[38;2;120;130;135mgo build -o bin/statusline ./cmd/statusline\033[0m\n'
fi
exit 0
