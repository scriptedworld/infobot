#!/usr/bin/env python3
"""The status line's entry point, and nothing else.

The render lives in `infobot/render.py`, where a test can import it and a
checker can read it. This file only resolves that import and delegates, which
is the same split `silo/docs/PATTERNS/go-command-entry-points.md` describes for
Go: a body written in an entry point can only be reached by running the binary.

The path is resolved from this file rather than from the working directory,
because Claude Code invokes it by absolute path from wherever the session
happens to be. No install step, no virtualenv, nothing that can be half
present: the status line has to render or it shows nothing at all.
"""

import sys
from pathlib import Path

# Before the import, or the first run leaves a __pycache__ beside the source.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from infobot.render import main  # noqa: E402

sys.exit(main())
