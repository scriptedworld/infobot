#!/bin/sh
# The SessionEnd entry point. Claude Code names this path in silo's
# settings.json, so this file is committed and the binary beside it is not.
#
# It exits 0 whatever happens, which is FR-1.11f. A cleanup that fails is
# litter; a cleanup that raises is a hook failure reported to somebody who was
# closing their terminal.
#
# Unlike the status line, an absent binary here says nothing to the terminal.
# There is no line to occupy and nobody is looking: a hook runs as a session
# ends. What it leaves instead is the state files it did not remove, which is
# the condition itself rather than a report of it, and the next `/grok` that
# counts them finds it.
set -u

here=$(dirname "$0")
binary="$here/forget"

if [ -x "$binary" ]; then
    exec "$binary"
fi

cat >/dev/null 2>&1 || true
exit 0
